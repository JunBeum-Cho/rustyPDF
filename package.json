{
  "name": "rustypdf",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-assets.mjs && tsc && tsc -p tsconfig.electron.json && vite build && node scripts/build-electron.mjs",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "pack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "build:windows": "npm run build && electron-builder --win --x64 --arm64",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "dompurify": "3.4.17",
    "exifr": "7.1.3",
    "lucide-solid": "^1.11.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "solid-js": "1.9.17",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  },
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  }
}
